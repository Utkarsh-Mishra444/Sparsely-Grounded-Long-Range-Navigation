cff-version: 1.2.0
message: "If you use AgentNav, CityNav, or Verbalization of Path, please cite the EACL 2026 paper in preferred-citation."
type: software
title: "AgentNav: Sparsely Grounded Long-Range Navigation"
authors:
  - family-names: Dalal
    given-names: Dwip
